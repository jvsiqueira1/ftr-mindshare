{
  "compilerOptions": {
    "outDir": "dist",
    "lib": ["es2025", "dom"],
    "target": "es2025",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "@/*": ["./src/*"],
      "@prisma/client": ["./src/generated/prisma/client.ts"]
    }
  },
  "include": ["src", "prisma", "prisma7.config.ts"]
}
